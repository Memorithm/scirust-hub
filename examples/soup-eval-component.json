    "outputs": [
      {
        "name": "result",
        "path": "outputs/soup-eval-result.json",
        "media_type": "application/vnd.scirust-hub.soup-eval-result.v1+json",
        "required": true
      }
    ]
  },
  "metadata": {
    "upstream_repository": "https://github.com/MakazhanAlpamys/Soup",
    "upstream_release_reference": "v0.73.3",
