{
  "schema_version": 1,
  "id": "00000000-0000-0000-0000-000000000001",
  "name": "SciCapsule",
  "version": "0.1.0",
  "kind": "tool",
  "capabilities": [
    {
      "name": "capsule.execute",
      "contract_version": "1.0.0",
      "inputs": [
        {
          "name": "capsule",
          "description": "application/vnd.scirust.scicap"
        },
        {
          "name": "policy",
          "description": "application/vnd.scicapsule.trust-policy.v1+json"
        },
        {
          "name": "request",
          "description": "application/vnd.scicapsule.hub-run-request.v1+json"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "description": "application/vnd.scicapsule.hub-run-result.v1+json"
        }
      ],
      "properties": {
        "authorization": "local_trust_policy",
        "request_media_type": "application/vnd.scicapsule.hub-run-request.v1+json",
        "result_media_type": "application/vnd.scicapsule.hub-run-result.v1+json",
        "sandbox": "none"
      }
    }
  ],
  "execution": {
    "type": "process",
    "program": "/opt/scicapsule/bin/scicapsule",
    "args": [
      "hub-run",
      "--capsule",
      "{input:capsule}",
      "--policy",
      "{input:policy}",
      "--request",
      "{input:request}",
      "--result",
      "{output:result}"
    ],
    "outputs": [
      {
        "name": "result",
        "path": "outputs/scicapsule-result.json",
        "media_type": "application/vnd.scicapsule.hub-run-result.v1+json",
        "required": true
      }
    ]
  },
  "metadata": {
    "canonical_capsule_owner": "scirust",
    "contract": "scicapsule-hub-v1"
  }
}
