{
  "schema_version": 1,
  "id": "00000000-0000-0000-0000-000000000008",
  "name": "Forge SOUP Post-Training Search",
  "version": "1.0.0",
  "kind": "tool",
  "capabilities": [
    {
      "name": "llm.optimize.forge_soup",
      "contract_version": "1.0.0",
      "inputs": [
        {
          "name": "campaign",
          "description": "application/vnd.forge.soup-posttrain-campaign.v1+json; exact candidate space, objective directions, holdout boundary and upstream contract"
        },
        {
          "name": "config",
          "description": "text/yaml; SOUP config template containing ${SOUP_HUB_DATASET}, ${SOUP_HUB_OUTPUT}, and ${FORGE_SOUP:<dimension>} tokens"
        },
        {
          "name": "dataset",
          "description": "Immutable dataset consumed by every candidate's SOUP dry-run/train execution"
        }
      ],
      "outputs": [
        {
          "name": "report",
          "description": "application/vnd.scirust-hub.forge-soup-campaign-report.v1+json"
        },
        {
          "name": "evidence_bundle",
          "description": "application/vnd.scirust-hub.forge-soup-evidence.v1+tar"
        }
      ],
      "properties": {
        "execution_mode": "local_process",
        "forge.runner_merge": "9e1f3fc568c176f401735c121780d9fbe6834f5d",
        "forge.domain_merge": "1385c71a541419f15a558a5e94bc8a4a60567a4a",
        "forge.runner_path": "/opt/scirust-hub/libexec/forge-soup-posttrain",
        "forge.evaluator_path": "/opt/scirust-hub/libexec/forge_soup_hub_evaluator.py",
        "forge.distributed_workers": "disabled_v1",
        "forge.external_isolation": "not_provided_fail_closed",
        "soup.qualified_commit": "05b646523727925990530667e7012ede50bd30b2",
        "soup.verify": "train_dry_run",
        "soup.measure": "train_then_isolated_tracker_benchmark",
        "metrics.allowed": "benchmark:<task>,train_wall_ms,eval_wall_ms,total_wall_ms",
        "ml.resource_contract": "hub.ml.resource-requirements@1.0.0",
        "ml.backend": "forge+soup",
        "ml.device": "runtime_configured",
        "ml.dtype": "runtime_configured",
        "ml.accelerator": "runtime_configured",
        "ml.memory": "runtime_preflight",
        "ml.placement_enforcement": "component_preflight"
      }
    }
  ],
  "execution": {
    "type": "process",
    "program": "python3",
    "args": [
      "/opt/scirust-hub/libexec/forge_soup_hub_adapter.py",
      "--campaign",
      "{input:campaign}",
      "--config",
      "{input:config}",
      "--dataset",
      "{input:dataset}",
      "--report",
      "{output:report}",
      "--evidence-bundle",
      "{output:evidence_bundle}",
      "--params",
      "{params}"
    ],
    "outputs": [
      {
        "name": "report",
        "path": "outputs/forge-soup-campaign-report.json",
        "media_type": "application/vnd.scirust-hub.forge-soup-campaign-report.v1+json",
        "required": true
      },
      {
        "name": "evidence_bundle",
        "path": "outputs/forge-soup-evidence.tar",
        "media_type": "application/vnd.scirust-hub.forge-soup-evidence.v1+tar",
        "required": true
      }
    ]
  },
  "metadata": {
    "forge_repository": "https://github.com/Memorithm/Forge",
    "forge_runner_pull_request": "26",
    "forge_runner_final_exact_head": "dc3189591436da6e27734b2953e94eaad7057f1e",
    "forge_runner_merge": "9e1f3fc568c176f401735c121780d9fbe6834f5d",
    "forge_domain_pull_request": "25",
    "forge_domain_merge": "1385c71a541419f15a558a5e94bc8a4a60567a4a",
    "soup_repository": "https://github.com/MakazhanAlpamys/Soup",
    "soup_qualified_commit": "05b646523727925990530667e7012ede50bd30b2",
    "contract": "forge-soup-posttrain-hub-v1"
  }
